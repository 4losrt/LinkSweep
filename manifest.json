{
  "manifest_version": 3,
  "name": "LinkSweep — Clean URLs",
  "version": "1.3.6",
  "description": "Safely clean copied and opened URLs using ClearURLs, AdGuard and uBlock sources, with programmatic clipboard interception and conservative Threads link resolution.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "offscreen",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkSweep — Clean URLs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon_16.png",
      "48": "img/icon_48.png",
      "128": "img/icon_128.png"
    }
  },
  "icons": {
    "16": "img/icon_16.png",
    "48": "img/icon_48.png",
    "128": "img/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "cleaner.js", "special_urls.js", "content_copy_cleaner.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["navigation_main_bundle.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
